# my.telegram.org saytidan olinadi
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# @BotFather'dan olingan bot tokeni
BOT_TOKEN=your_bot_token

# --- Go Streamer sozlamalari ---

# Go server qaysi portda tinglaydi
PORT=8081

# Local Telegram Bot API Server manzili (docker-compose ichida service nomi orqali)
BOT_API_URL=http://telegram-bot-api:8080

# SSD kesh papkasi (docker-compose orqali volume sifatida ulanadi)
CACHE_DIR=/cache

# Telegram'dan bir vaqtda nechta fayl bir vaqtda tortilishi mumkin (IP-block bo'lmasligi uchun)
MAX_CONCURRENT_FETCH=20

# Kesh hajmi chegarasi (GB), undan oshsa eng eski fayllar o'chiriladi
MAX_CACHE_SIZE_GB=400

# Necha daqiqada bir marta LRU eviction ishga tushadi
CACHE_EVICT_INTERVAL_MIN=60
