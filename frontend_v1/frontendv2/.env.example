# Backend API origin. Change this value when the server moves.
NEXT_PUBLIC_API_URL=http://16.170.242.253:8000

# Optional streamer health endpoint.
NEXT_PUBLIC_STREAMER_HEALTH=http://16.170.242.253:8081/health

# Optional explicit voice WebSocket URL. If omitted, it is derived from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_VOICE_WS_URL=ws://16.170.242.253:8000/ws/agent/{session_id}/

# AI/voice agent WebSocket. Change only this env value when the backend moves.
NEXT_PUBLIC_AI_WS_URL=ws://16.170.242.253:8000/ws/agent/{session_id}/

# Backend-owned Google OAuth entrypoint (legacy redirect fallback, not required by the GSI flow below).
NEXT_PUBLIC_GOOGLE_AUTH_URL=http://16.170.242.253:8000/v1/auth/google/

# Google Identity Services client ID (public value, safe to read server-side and hand to the browser).
# Used by the login/register pages to render the real "Sign in with Google" button and exchange the
# resulting ID token with POST /v1/auth/google/login on the backend. The matching client secret is
# only needed by the backend (if it verifies tokens server-to-server) and must never be sent to the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
